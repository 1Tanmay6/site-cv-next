{
  "name": "esportfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:clean": "npm run clean && npm run build",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:install": "playwright install --with-deps",
    "test:bundle": "node scripts/check-bundle-budget.mjs",
    "test:bundle:update": "node scripts/check-bundle-budget.mjs --update",
    "perf:measure": "node scripts/measure-web-vitals.mjs",
    "perf:measure:update": "node scripts/measure-web-vitals.mjs --update",
    "mail:test-account": "node scripts/create-test-mailbox.mjs",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "audit:check": "node scripts/audit-check.mjs",
    "verify": "npm run lint && npm run test && npm run build && npm run test:bundle && npm run audit:check"
  },
  "dependencies": {
    "@tsparticles/react": "^4.5.0",
    "@tsparticles/slim": "^4.5.0",
    "framer-motion": "^14.9.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "react": "19.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "swiper": "^14.4.0",
    "tailwind-scrollbar": "^4.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
