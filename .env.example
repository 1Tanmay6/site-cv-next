# Contact storage configuration. Copy to `.env.local` for local development.
# Every valid contact request creates a new .txt file in a GitHub repository.
#
# Production (Vercel): set these in the dashboard. Mark git_pat_token Sensitive.
# repo_name must be owner/repository, ideally a private repo.
# git_pat_token needs contents:write on that repository only.
repo_name=
git_pat_token=

# Optional: defaults to github. Use json for local tests with no GitHub writes.
# CONTACT_STORE=json

# Optional contact endpoint hardening overrides.
# CONTACT_ALLOWED_ORIGINS=https://example.com
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MS=60000
# CONTACT_GLOBAL_RATE_LIMIT_MAX=60
# CONTACT_GLOBAL_RATE_LIMIT_WINDOW_MS=60000
# CONTACT_BODY_LIMIT_BYTES=16384

# Security header rollout: set to true to emit Content-Security-Policy-Report-Only.
# CSP_REPORT_ONLY=false
