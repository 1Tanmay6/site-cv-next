# Server-only mail configuration. Copy this file to `.env.local` and fill in
# values from your deployment secret store. Never commit real credentials.
#
# For local email testing only:
#   npm run mail:test-account
# creates `.env.local` with an ephemeral Ethereal mailbox and prints a preview URL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Test-only transport. Set to `json` to exercise the API without sending mail.
# Never set this in production.
# CONTACT_MAIL_TRANSPORT=json

# Optional contact endpoint hardening overrides.
# CONTACT_ALLOWED_ORIGINS=https://example.com
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MS=60000
# CONTACT_GLOBAL_RATE_LIMIT_MAX=60
# CONTACT_GLOBAL_RATE_LIMIT_WINDOW_MS=60000
# CONTACT_BODY_LIMIT_BYTES=16384

# Security header rollout: set to true to emit Content-Security-Policy-Report-Only.
# CSP_REPORT_ONLY=false
